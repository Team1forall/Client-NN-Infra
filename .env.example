# Public URL of the site, no trailing slash. Used for metadata, sitemap, robots and the Project N QR code.
# Optional on Vercel: when unset, the project's production domain is used automatically.
NEXT_PUBLIC_SITE_URL=

# Google Apps Script web app URL (ends in /exec) that appends enquiries to the Sheet. Empty = form shows "not connected yet".
GOOGLE_SHEETS_WEBHOOK_URL=

# Shared secret; must equal the SHARED_SECRET Script Property. Server-only: never prefix with NEXT_PUBLIC_.
GOOGLE_SHEETS_WEBHOOK_SECRET=
